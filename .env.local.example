NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=re_your_api_key
QUOTE_EMAIL_FROM=noreply@yourdomain.com

# Rootline tracker (/tracker) — Lemon Squeezy subscriptions
LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=https://yourstore.lemonsqueezy.com/buy/monthly-variant-id
LEMONSQUEEZY_CHECKOUT_URL_YEARLY=https://yourstore.lemonsqueezy.com/buy/yearly-variant-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Rootline check-in reminder emails (daily cron at /api/tracker/reminders)
CRON_SECRET=long-random-string
TRACKER_EMAIL_FROM=Rootline <reminders@yourdomain.com>

# Rootline Android app (Play Store, optional) — served at /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=com.yourdomain.rootline
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:...

# Rootline legal pages (/tracker/privacy, /tracker/terms, /tracker/refunds)
NEXT_PUBLIC_TRACKER_COMPANY_NAME=Your Legal Business Name
NEXT_PUBLIC_TRACKER_SUPPORT_EMAIL=support@yourdomain.com
# Optional: lets account deletion cancel an active subscription automatically
LEMONSQUEEZY_API_KEY=

# Rootline guides: name of the doctor who medically reviewed /tracker/guides.
# Until set, the medical guides are hidden from search engines (noindex).
NEXT_PUBLIC_TRACKER_MEDICAL_REVIEWER=
